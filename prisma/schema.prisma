generator client {
  provider     = "prisma-client"
  output       = "src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model TripInquiries {
  id             Int       @id @default(autoincrement())
  destination    String?   @db.VarChar(100)
  days           Int?
  month          String?   @db.VarChar(50)
  adults         Int?
  children       Int?
  hotel_category String?   @db.VarChar(50)
  preferences    String?   @db.Text
  email          String?   @db.VarChar(100)
  phone          String?   @db.VarChar(20)
  budget_min     Int?
  budget_max     Int?
  created_at     DateTime? @default(now()) @db.Timestamp(0)
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model articles {
  id               Int
  title            String           @db.VarChar(255)
  slug             String           @db.VarChar(255)
  content          String           @db.LongText
  cover_image      String?          @db.VarChar(500)
  author           String           @db.VarChar(150)
  category         String?          @db.VarChar(150)
  status           articles_status? @default(draft)
  published_at     DateTime?        @db.DateTime(0)
  created_at       DateTime?        @default(now()) @db.Timestamp(0)
  updated_at       DateTime?        @default(now()) @db.Timestamp(0)
  meta_title       String?          @db.VarChar(255)
  meta_description String?          @db.Text

  @@ignore
}

model booking_details {
  id              Int              @id @default(autoincrement())
  tour_id         Int
  name            String           @db.VarChar(255)
  email           String           @db.VarChar(255)
  phone           String           @db.VarChar(15)
  days            Int?
  adults          Int
  children        Int              @default(0)
  child_ages      String?          @db.LongText
  hotel_rating    String?          @db.VarChar(255)
  meal_plan       String?          @db.VarChar(255)
  flight_option   String?          @db.VarChar(255)
  flight_number   String?          @db.VarChar(255)
  travel_date     DateTime         @db.Date
  departure_id    Int?
  created_at      DateTime?        @default(now()) @db.Timestamp(0)
  booking_id      BigInt           @unique(map: "uq_booking_details_booking")
  updated_at      DateTime?        @default(now()) @db.Timestamp(0)
  tours           tours            @relation(fields: [tour_id], references: [id], onUpdate: Restrict, map: "fk_booking_details_tour")
  tour_departures tour_departures? @relation(fields: [departure_id], references: [id], map: "fk_bd_departure")

  @@index([booking_id], map: "idx_bd_booking")
  @@index([departure_id], map: "idx_bd_departure")
  @@index([tour_id], map: "idx_bd_tour")
  @@index([booking_id], map: "idx_booking_details_booking")
  @@index([booking_id], map: "idx_booking_details_booking_id")
  @@index([departure_id], map: "idx_booking_details_departure")
}

model bookings {
  id                     BigInt                    @id @default(autoincrement())
  tour_id                Int
  user_id                Int?
  customer_name          String?                   @db.VarChar(120)
  customer_email         String?                   @db.VarChar(120)
  customer_phone         String?                   @db.VarChar(20)
  guests                 Int?                      @default(1)
  travel_date            DateTime?                 @db.Date
  departure_id           Int?
  total_amount_paise     Int
  ops_notes              String?                   @db.Text
  follow_up_status       bookings_follow_up_status @default(pending)
  follow_up_date         DateTime?                 @db.Date
  follow_up_note         String?                   @db.Text
  payment_status         bookings_payment_status?  @default(UNPAID)
  status                 bookings_status?          @default(PENDING)
  created_at             DateTime?                 @default(now()) @db.Timestamp(0)
  booking_follow_up_logs booking_follow_up_logs[]
  booking_travellers     booking_travellers[]
  tour_departures        tour_departures?          @relation(fields: [departure_id], references: [id], map: "fk_bookings_departure")
  payment_details        payment_details[]
  payments               payments[]
  traveller_documents    traveller_documents[]

  @@index([departure_id], map: "idx_bookings_departure")
  @@index([customer_email, created_at], map: "idx_bookings_email_created")
  @@index([user_id, created_at], map: "idx_bookings_user_created")
}

model contacts {
  id           Int       @id @default(autoincrement())
  contact_id   String    @unique(map: "contact_id") @db.VarChar(50)
  first_name   String    @db.VarChar(255)
  email        String    @db.VarChar(255)
  phone_number String?   @db.VarChar(20)
  subject      String    @db.VarChar(255)
  message      String    @db.Text
  created_at   DateTime? @default(now()) @db.Timestamp(0)
}

model destination_activities {
  id             Int          @id @default(autoincrement())
  destination_id Int
  title          String?      @db.VarChar(255)
  image_url      String?      @db.LongText
  destinations   destinations @relation(fields: [destination_id], references: [id], onUpdate: Restrict, map: "destination_activities_ibfk_1")

  @@index([destination_id], map: "destination_id")
}

model destination_attractions {
  id             Int          @id @default(autoincrement())
  destination_id Int
  title          String?      @db.VarChar(255)
  image_url      String?      @db.LongText
  rating         Float?       @db.Float
  video_url      String?      @db.Text
  destinations   destinations @relation(fields: [destination_id], references: [id], onUpdate: Restrict, map: "destination_attractions_ibfk_1")

  @@index([destination_id], map: "destination_id")
}

model destination_cuisines {
  id             Int          @id @default(autoincrement())
  destination_id Int
  title          String?      @db.VarChar(255)
  image_url      String?      @db.LongText
  destinations   destinations @relation(fields: [destination_id], references: [id], onUpdate: Restrict, map: "destination_cuisines_ibfk_1")

  @@index([destination_id], map: "destination_id")
}

model destination_ethnicities {
  id             Int          @id @default(autoincrement())
  destination_id Int
  title          String?      @db.VarChar(255)
  image_url      String?      @db.LongText
  destinations   destinations @relation(fields: [destination_id], references: [id], onUpdate: Restrict, map: "destination_ethnicities_ibfk_1")

  @@index([destination_id], map: "destination_id")
}

model destination_itinerary_blocks {
  id             Int          @id @default(autoincrement())
  destination_id Int
  title          String?      @db.VarChar(255)
  description    String?      @db.Text
  destinations   destinations @relation(fields: [destination_id], references: [id], onUpdate: Restrict, map: "destination_itinerary_blocks_ibfk_1")

  @@index([destination_id], map: "destination_id")
}

model destinations {
  id                           Int                            @id @default(autoincrement())
  title                        String                         @unique(map: "title") @db.VarChar(255)
  best_time_to_visit           String?                        @db.VarChar(255)
  weather                      String?                        @db.VarChar(255)
  currency                     String?                        @db.VarChar(100)
  language                     String?                        @db.VarChar(100)
  time_zone                    String?                        @db.VarChar(100)
  description                  String?                        @db.Text
  meta_title                   String?                        @db.VarChar(255)
  meta_description             String?                        @db.Text
  parent_id                    Int?
  image_url                    String?                        @db.VarChar(512)
  destination_activities       destination_activities[]
  destination_attractions      destination_attractions[]
  destination_cuisines         destination_cuisines[]
  destination_ethnicities      destination_ethnicities[]
  destination_itinerary_blocks destination_itinerary_blocks[]
  destinations                 destinations?                  @relation("destinationsTodestinations", fields: [parent_id], references: [id], onUpdate: Restrict, map: "fk_parent_destination")
  other_destinations           destinations[]                 @relation("destinationsTodestinations")
  location_destinations        location_destinations[]
  tour_destinations            tour_destinations[]
  tours                        tours[]

  @@index([parent_id], map: "fk_parent_destination")
  @@index([id, title], map: "idx_dest_id_title")
}

model enquiries {
  id          Int       @id @default(autoincrement())
  tour_id     Int
  name        String    @db.VarChar(255)
  email       String    @db.VarChar(255)
  phone       String    @db.VarChar(15)
  description String?   @db.Text
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  tours       tours     @relation(fields: [tour_id], references: [id], onUpdate: Restrict, map: "enquiries_ibfk_1")

  @@index([tour_id], map: "tour_id")
}

model faqs {
  id         Int       @id @default(autoincrement())
  question   String    @db.VarChar(255)
  answer     String    @db.Text
  category   String?   @db.VarChar(100)
  is_active  Boolean?  @default(true)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
}

model items {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(0)
}

model itineraries {
  id             Int       @id @default(autoincrement())
  name           String    @db.VarChar(255)
  email          String    @db.VarChar(255)
  phone          String    @db.VarChar(50)
  destination    String?   @db.VarChar(255)
  travelers      Int
  children       Int
  child_ages     String?   @db.LongText
  duration       Int
  date           DateTime  @db.Date
  budget         String    @db.VarChar(100)
  hotel_category String    @db.VarChar(100)
  travel_type    String    @db.VarChar(100)
  occupation     String    @db.VarChar(100)
  preferences    String?   @db.Text
  created_at     DateTime? @default(now()) @db.Timestamp(0)
}

model itinerary_days {
  id             Int       @id @default(autoincrement())
  tour_id        Int
  day_number     Int
  title          String    @db.VarChar(255)
  description    String    @db.Text
  activities     String?   @db.LongText
  meals_included String?   @db.LongText
  accommodation  String?   @db.VarChar(255)
  created_at     DateTime? @default(now()) @db.Timestamp(0)
  tours          tours     @relation(fields: [tour_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "itinerary_days_ibfk_1")

  @@unique([tour_id, day_number], map: "uk_tour_day")
  @@index([tour_id, day_number], map: "idx_itinerary_days_day")
  @@index([tour_id], map: "idx_itinerary_days_tour_id")
}

model job_applications {
  id           Int                     @id @default(autoincrement())
  job_id       Int
  name         String                  @db.VarChar(100)
  email        String                  @db.VarChar(150)
  phone        String?                 @db.VarChar(20)
  resume_url   String?                 @db.VarChar(255)
  cover_letter String?                 @db.Text
  status       job_applications_status @default(Pending)
  applied_at   DateTime?               @default(now()) @db.Timestamp(0)
  jobs         jobs                    @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_job")

  @@index([job_id], map: "fk_job")
}

model jobs {
  id                   Int                @id @default(autoincrement())
  title                String             @db.VarChar(150)
  department           String?            @db.VarChar(100)
  location             String?            @db.VarChar(150)
  type                 jobs_type          @default(Full_time)
  description          String?            @db.Text
  requirements         String?            @db.Text
  responsibilities     String?            @db.Text
  salary_range         String?            @db.VarChar(100)
  experience_required  String?            @db.VarChar(50)
  status               jobs_status        @default(Draft)
  created_at           DateTime?          @default(now()) @db.Timestamp(0)
  updated_at           DateTime?          @default(now()) @db.Timestamp(0)
  application_deadline DateTime?          @db.Date
  job_applications     job_applications[]
}

model location_destinations {
  location_id    Int
  destination_id Int
  locations      locations    @relation(fields: [location_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "location_destinations_ibfk_1")
  destinations   destinations @relation(fields: [destination_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "location_destinations_ibfk_2")

  @@id([location_id, destination_id])
  @@index([destination_id], map: "destination_id")
  @@index([location_id, destination_id], map: "idx_locdest_loc")
}

model locations {
  id                    Int                     @id @default(autoincrement())
  destination_id        Int
  name                  String?                 @db.VarChar(255)
  description           String?                 @db.Text
  iframe_360            String?                 @db.Text
  image_url             String?                 @db.VarChar(512)
  location_destinations location_destinations[]
  tour_locations        tour_locations[]

  @@index([destination_id], map: "destination_id")
  @@index([id], map: "idx_locations_id")
}

model newsletter_subscribers {
  id                Int                            @id @default(autoincrement())
  email             String                         @unique(map: "email") @db.VarChar(255)
  name              String?                        @db.VarChar(100)
  subscribed_at     DateTime?                      @default(now()) @db.DateTime(0)
  is_verified       Boolean?                       @default(false)
  unsubscribe_token String?                        @db.VarChar(255)
  unsubscribed_at   DateTime?                      @db.DateTime(0)
  ip_address        String?                        @db.VarChar(45)
  user_agent        String?                        @db.Text
  source            newsletter_subscribers_source? @default(website)
  status            newsletter_subscribers_status? @default(active)

  @@index([email], map: "email_2")
  @@index([status], map: "status")
}

model payment_details {
  id             BigInt    @id @default(autoincrement())
  booking_id     BigInt
  hotel_rating   String?   @db.VarChar(10)
  meal_plan      String?   @db.VarChar(50)
  flight_option  String?   @db.VarChar(20)
  flight_number  String?   @db.VarChar(50)
  children_count Int?      @default(0)
  child_ages     String?   @db.Text
  notes          String?   @db.Text
  created_at     DateTime? @default(now()) @db.Timestamp(0)
  bookings       bookings  @relation(fields: [booking_id], references: [id], onUpdate: Restrict, map: "payment_details_ibfk_1")

  @@index([booking_id], map: "booking_id")
}

model payments {
  id                  BigInt           @id @default(autoincrement())
  booking_id          BigInt
  tour_id             BigInt
  user_id             BigInt?          @db.UnsignedBigInt
  razorpay_order_id   String           @unique(map: "razorpay_order_id") @db.VarChar(64)
  razorpay_payment_id String?          @db.VarChar(64)
  razorpay_signature  String?          @db.VarChar(255)
  amount_paise        Int
  currency            String?          @default("INR") @db.VarChar(10)
  status              payments_status? @default(created)
  notes               String?          @db.Text
  created_at          DateTime?        @default(now()) @db.Timestamp(0)
  updated_at          DateTime?        @default(now()) @db.Timestamp(0)
  bookings            bookings         @relation(fields: [booking_id], references: [id], onUpdate: Restrict, map: "fk_payments_booking")

  @@index([booking_id], map: "booking_id")
  @@index([booking_id, created_at], map: "idx_payments_booking_created")
}

model room_types {
  id             Int       @id @default(autoincrement())
  tour_id        Int
  name           String    @db.VarChar(255)
  description    String?   @db.Text
  max_occupancy  Int       @default(2)
  price_modifier Decimal?  @default(0.00) @db.Decimal(10, 2)
  is_available   Boolean?  @default(true)
  created_at     DateTime? @default(now()) @db.Timestamp(0)
  tours          tours     @relation(fields: [tour_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "room_types_ibfk_1")

  @@index([tour_id], map: "idx_room_types_tour_id")
}

model settings {
  id        Int    @id @default(autoincrement())
  key_name  String @unique(map: "key_name") @db.VarChar(100)
  key_value String @db.Text
}

model tour_departures {
  id              Int               @id @default(autoincrement())
  tour_id         Int
  departure_date  DateTime          @db.Date
  available_seats Int
  updated_at      DateTime          @default(now()) @db.Timestamp(0)
  booking_details booking_details[]
  bookings        bookings[]
  tours           tours             @relation(fields: [tour_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "tour_departures_ibfk_1")

  @@index([id], map: "idx_td_id")
  @@index([tour_id, departure_date], map: "idx_tour_departures_tour_date")
  @@index([tour_id, departure_date], map: "ix_departures_tour_date")
}

model tour_destinations {
  tour_id        Int
  destination_id Int
  tours          tours        @relation(fields: [tour_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "tour_destinations_ibfk_1")
  destinations   destinations @relation(fields: [destination_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "tour_destinations_ibfk_2")

  @@id([tour_id, destination_id])
  @@index([destination_id], map: "destination_id")
}

model tour_locations {
  tour_id     Int
  location_id Int
  locations   locations @relation(fields: [location_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_tl_location")
  tours       tours     @relation(fields: [tour_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_tl_tour")

  @@id([tour_id, location_id])
  @@index([location_id], map: "idx_location")
}

model tour_photos {
  id            Int       @id @default(autoincrement())
  tour_id       Int
  url           String    @db.VarChar(500)
  caption       String?   @db.VarChar(255)
  is_primary    Boolean?  @default(false)
  display_order Int?      @default(0)
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  tours         tours     @relation(fields: [tour_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "tour_photos_ibfk_1")

  @@index([tour_id, is_primary], map: "idx_tour_photos_primary")
  @@index([tour_id], map: "idx_tour_photos_tour_id")
}

model tour_reviews {
  id             Int       @id @default(autoincrement())
  tour_id        Int
  reviewer_name  String    @db.VarChar(255)
  reviewer_email String?   @db.VarChar(255)
  rating         Int
  comment        String    @db.Text
  is_verified    Boolean?  @default(false)
  is_approved    Boolean?  @default(false)
  date           DateTime? @default(now()) @db.Timestamp(0)
  created_at     DateTime? @default(now()) @db.Timestamp(0)
  tours          tours     @relation(fields: [tour_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "tour_reviews_ibfk_1")

  @@index([is_approved], map: "idx_tour_reviews_approved")
  @@index([rating], map: "idx_tour_reviews_rating")
  @@index([tour_id], map: "idx_tour_reviews_tour_id")
}

model tours {
  id                             Int                     @id @default(autoincrement())
  destination_id                 Int?
  title                          String?                 @db.VarChar(255)
  slug                           String?                 @unique(map: "slug") @db.VarChar(255)
  description                    String?                 @db.Text
  duration_days                  Int?
  price                          Decimal?                @db.Decimal(10, 2)
  image_url                      String?                 @db.Text
  map_embed_url                  String?                 @db.Text
  category                       String?                 @db.VarChar(100)
  available_from                 DateTime?               @db.Date
  available_to                   DateTime?               @db.Date
  created_at                     DateTime?               @default(now()) @db.Timestamp(0)
  departure_airport              String?                 @db.VarChar(255)
  arrival_airport                String?                 @db.VarChar(255)
  max_group_size                 Int?
  min_group_size                 Int?
  inclusions                     String?                 @db.LongText
  exclusions                     String?                 @db.LongText
  complementaries                String?                 @db.LongText
  highlights                     String?                 @db.LongText
  booking_terms                  String?                 @db.Text
  cancellation_policy            String?                 @db.Text
  meta_title                     String?                 @db.VarChar(255)
  meta_description               String?                 @db.Text
  price_per_person               Decimal?                @db.Decimal(10, 2)
  price_with_flight              Decimal                 @default(0.00) @db.Decimal(10, 2)
  price_currency                 String?                 @default("INR") @db.VarChar(3)
  early_bird_discount            Decimal?                @db.Decimal(5, 2)
  group_discount                 Decimal?                @db.Decimal(5, 2)
  difficulty_level               tours_difficulty_level?
  physical_requirements          String?                 @db.Text
  best_time_to_visit             String?                 @db.VarChar(255)
  weather_info                   String?                 @db.Text
  packing_list                   String?                 @db.LongText
  languages_supported            String?                 @db.LongText
  guide_included                 Boolean?                @default(true)
  guide_languages                String?                 @db.LongText
  transportation_included        Boolean?                @default(true)
  transportation_details         String?                 @db.Text
  meals_included                 String?                 @db.LongText
  dietary_restrictions_supported String?                 @db.LongText
  accommodation_type             String?                 @db.VarChar(255)
  accommodation_rating           Int?
  activity_types                 String?                 @db.LongText
  interests                      String?                 @db.LongText
  instant_booking                Boolean?                @default(false)
  requires_approval              Boolean?                @default(true)
  advance_booking_days           Int?                    @default(7)
  is_active                      Boolean?                @default(true)
  is_featured                    Boolean?                @default(false)
  updated_at                     DateTime?               @default(now()) @db.Timestamp(0)
  adults                         Int?                    @default(0)
  children                       Int?                    @default(0)
  rooms                          Int?                    @default(1)
  is_customizable                Boolean?                @default(false)
  flight_included                Boolean?                @default(false)
  image_url_cdn                  String?                 @db.VarChar(512)
  booking_details                booking_details[]
  enquiries                      enquiries[]
  itinerary_days                 itinerary_days[]
  room_types                     room_types[]
  tour_departures                tour_departures[]
  tour_destinations              tour_destinations[]
  tour_locations                 tour_locations[]
  tour_photos                    tour_photos[]
  tour_reviews                   tour_reviews[]
  destinations                   destinations?           @relation(fields: [destination_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_tour_destination")
  wishlists                      wishlists[]

  @@index([destination_id], map: "fk_tour_destination")
  @@index([is_active], map: "idx_tours_active")
  @@index([available_from, available_to], map: "idx_tours_availability")
  @@index([category], map: "idx_tours_category")
  @@index([duration_days], map: "idx_tours_duration")
  @@index([is_featured], map: "idx_tours_featured")
  @@index([price], map: "idx_tours_price")
}

model trip_leads {
  id                 Int       @id @default(autoincrement())
  full_name          String    @db.VarChar(100)
  email              String    @db.VarChar(100)
  phone_number       String    @db.VarChar(20)
  preferred_country  String?   @db.VarChar(100)
  preferred_city     String?   @db.VarChar(100)
  departure_date     DateTime? @db.Date
  return_date        DateTime? @db.Date
  number_of_days     Int?
  number_of_adults   Int?
  number_of_children Int?
  number_of_male     Int?
  number_of_female   Int?
  number_of_other    Int?
  aged_persons       String?   @db.LongText
  hotel_rating       String?   @db.VarChar(10)
  meal_plan          String?   @db.VarChar(10)
  room_type          String?   @db.VarChar(50)
  need_flight        Boolean?
  departure_airport  String?   @db.VarChar(100)
  trip_type          String?   @db.VarChar(255)
  estimate_range     String?   @db.VarChar(50)
  created_at         DateTime? @default(now()) @db.Timestamp(0)
}

model user_tokens {
  id         Int              @id @default(autoincrement())
  user_id    BigInt           @db.UnsignedBigInt
  type       user_tokens_type
  token_hash String           @db.VarChar(255)
  expires_at DateTime         @db.DateTime(0)
  used_at    DateTime?        @db.DateTime(0)
  created_at DateTime?        @default(now()) @db.Timestamp(0)
  users      user             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_user_tokens_user")

  @@index([expires_at], map: "idx_expires")
  @@index([user_id, type], map: "idx_user_type")
}

model user {
  id                               BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  email                            String        @unique(map: "email") @db.VarChar(255)
  passwordHash                     String?       @db.VarChar(255)
  googleId                         String?       @unique(map: "uniq_googleId") @db.VarChar(255)
  role                             users_role?
  createdAt                        DateTime?     @default(now()) @db.Timestamp(0)
  truecallerId                     String?       @db.VarChar(255)
  refreshToken                     String?       @db.VarChar(512)
  is_active                        Boolean       @default(true)
  passwordChangedAt                DateTime?     @db.DateTime(0)
  is_email_verified                Boolean       @default(false)
  last_password_reset_requested_at DateTime?     @db.DateTime(0)
  last_password_changed_at         DateTime?     @db.DateTime(0)
  is_contact_no_verified           Boolean       @default(false)
  name                             String?       @db.Text
  contact_no                       String?       @unique(map: "contact_no") @db.VarChar(15)
  default_password                 String?       @db.VarChar(255)
  is_default_password_used         Boolean?
  assigned_leads                   leads[]       @relation("AssignedAgentLeads")
  user_tokens                      user_tokens[]
  wishlists                        wishlists[]

  @@map("users")
}

model wishlists {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  tour_id    Int
  created_at DateTime? @default(now()) @db.Timestamp(0)
  tours      tours     @relation(fields: [tour_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "wishlists_ibfk_2")
  users      user      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "wishlists_ibfk_1")

  @@unique([user_id, tour_id], map: "unique_user_tour")
  @@index([tour_id], map: "fk_wishlist_tour")
}

model booking_travellers {
  id                  BigInt                @id @default(autoincrement())
  booking_id          BigInt
  full_name           String                @db.VarChar(120)
  age                 Int?
  passport_number     String?               @db.VarChar(30)
  created_at          DateTime?             @default(now()) @db.Timestamp(0)
  updated_at          DateTime?             @default(now()) @db.Timestamp(0)
  email               String?               @db.VarChar(255)
  phone               String?               @db.VarChar(20)
  bookings            bookings              @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_travellers_booking")
  traveller_documents traveller_documents[]

  @@index([booking_id], map: "fk_travellers_booking")
}

model lead_activities {
  id            BigInt               @id @default(autoincrement())
  lead_id       BigInt
  activity_type lead_activities_type
  old_value     String?              @db.Text
  new_value     String?              @db.Text
  note          String?              @db.Text
  created_by    BigInt?
  created_at    DateTime?            @default(now()) @db.Timestamp(0)
  leads         leads                @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_lead_activities_lead")

  @@index([lead_id], map: "idx_lead_activities_lead_id")
  @@index([activity_type], map: "idx_lead_activities_type")
  @@index([created_at], map: "idx_lead_activities_created_at")
}

model lead_follow_ups {
  id             BigInt                 @id @default(autoincrement())
  lead_id        BigInt
  follow_up_date DateTime?              @db.DateTime(0)
  status         lead_follow_ups_status @default(pending)
  note           String?                @db.Text
  created_by     BigInt?
  created_at     DateTime?              @default(now()) @db.Timestamp(0)
  updated_at     DateTime?              @default(now()) @db.Timestamp(0)
  leads          leads                  @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_lead_followups_lead")

  @@index([lead_id], map: "idx_lead_followups_lead_id")
  @@index([follow_up_date], map: "idx_lead_followups_date")
  @@index([status], map: "idx_lead_followups_status")
}

model lead_sync_logs {
  id            BigInt    @id @default(autoincrement())
  source_type   String    @db.VarChar(50)
  source_table  String    @db.VarChar(100)
  source_row_id BigInt
  lead_id       BigInt
  synced_at     DateTime? @default(now()) @db.Timestamp(0)
  leads         leads     @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_lead_sync_logs_lead")

  @@unique([source_table, source_row_id], map: "uq_source_sync")
  @@index([lead_id], map: "idx_lead_sync_logs_lead_id")
  @@index([source_type], map: "idx_lead_sync_logs_source_type")
}

model leads {
  id                  BigInt                 @id @default(autoincrement())
  lead_code           String                 @unique(map: "lead_code") @db.VarChar(30)
  source_type         leads_source_type?
  source_table        String                 @db.VarChar(100)
  source_row_id       BigInt
  name                String                 @db.VarChar(255)
  email               String?                @db.VarChar(255)
  contact_no          String?                @db.VarChar(20)
  destination         String?                @db.VarChar(255)
  travel_date         DateTime?              @db.Date
  travellers_count    Int?
  budget              String?                @db.VarChar(100)
  source              String?                @db.VarChar(100)
  remark              String?                @db.Text
  status              leads_status           @default(new)
  assigned_agent_id   BigInt?                @db.UnsignedBigInt
  assigned_agent_name String?                @db.VarChar(255)
  follow_up_status    leads_follow_up_status @default(pending)
  follow_up_date      DateTime?              @db.DateTime(0)
  tour_id             BigInt?
  raw_payload         String?                @db.LongText
  created_at          DateTime?              @default(now()) @db.Timestamp(0)
  updated_at          DateTime?              @default(now()) @db.Timestamp(0)
  departure_type      leads_departure_type?  @default(others)
  lead_activities     lead_activities[]
  lead_follow_ups     lead_follow_ups[]
  lead_sync_logs      lead_sync_logs[]
  assigned_agent      user?                  @relation("AssignedAgentLeads", fields: [assigned_agent_id], references: [id], map: "fk_leads_assigned_agent")

  @@index([status], map: "idx_leads_status")
  @@index([assigned_agent_id], map: "idx_leads_assigned_agent_id")
  @@index([follow_up_date], map: "idx_leads_follow_up_date")
  @@index([source_type], map: "idx_leads_source_type")
  @@index([email], map: "idx_leads_email")
  @@index([contact_no], map: "idx_leads_contact_no")
  @@index([travel_date], map: "idx_leads_travel_date")
  @@index([source_table, source_row_id], map: "idx_leads_source_row")
}

model traveller_documents {
  id                   BigInt                       @id @default(autoincrement())
  booking_id           BigInt
  traveller_id         BigInt
  doc_type             traveller_documents_doc_type
  doc_label            String?                      @db.VarChar(120)
  status               traveller_documents_status?  @default(not_uploaded)
  file_url             String?                      @db.Text
  file_name            String?                      @db.VarChar(255)
  cloudinary_public_id String?                      @db.VarChar(255)
  rejection_reason     String?                      @db.VarChar(255)
  uploaded_at          DateTime?                    @default(now()) @db.Timestamp(0)
  updated_at           DateTime?                    @default(now()) @db.Timestamp(0)
  required_doc_type    String?                      @db.VarChar(20)
  bookings             bookings                     @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_doc_booking")
  booking_travellers   booking_travellers           @relation(fields: [traveller_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_doc_traveller")

  @@unique([booking_id, traveller_id, required_doc_type], map: "uq_required_docs")
  @@index([traveller_id], map: "fk_doc_traveller")
}

model booking_follow_up_logs {
  id             BigInt                        @id @default(autoincrement())
  booking_id     BigInt
  status         booking_follow_up_logs_status
  note           String?                       @db.Text
  follow_up_date DateTime?                     @db.Date
  created_by     BigInt?
  created_at     DateTime?                     @default(now()) @db.Timestamp(0)
  bookings       bookings                      @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_booking_followup_booking")

  @@index([booking_id], map: "fk_booking_followup_booking")
}

